<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>通勤記錄</title>
<style>
  :root {
    --navy:  #1A2F5E;
    --blue:  #0066CC;
    --teal:  #00A8B5;
    --green: #16A34A;
    --amber: #D97706;
    --red:   #DC2626;
    --gray:  #64748B;
    --light: #F4F7FB;
    --white: #FFFFFF;
    --border:#E2E8F0;
    --text:  #1E293B;
    --sub:   #94A3B8;
    --r: 14px;
    --safe-bottom: env(safe-area-inset-bottom, 20px);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  body { font-family: -apple-system, 'PingFang TC', sans-serif; background: var(--light); color: var(--text); min-height: 100dvh; overflow-x: hidden; }

  /* TOPBAR */
  .topbar { background: var(--navy); color: #fff; padding: 52px 20px 16px; display: flex; align-items: flex-end; justify-content: space-between; }
  .topbar h1 { font-size: 22px; font-weight: 700; }
  .topbar .sub { font-size: 12px; color: var(--teal); margin-top: 2px; }
  .stat-box { background: rgba(255,255,255,0.1); border-radius: 10px; padding: 6px 14px; text-align: right; }
  .stat-num { font-size: 22px; font-weight: 800; color: var(--teal); }
  .stat-label { font-size: 10px; color: rgba(255,255,255,0.6); }

  /* PAGES */
  .page { display: none; }
  .page.active { display: block; }
  .page-content { padding-bottom: calc(70px + var(--safe-bottom)); }

  /* BOTTOM NAV */
  .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: var(--white); border-top: 1px solid var(--border); display: flex; padding-bottom: var(--safe-bottom); z-index: 100; }
  .nav-item { flex: 1; padding: 10px 4px 6px; text-align: center; cursor: pointer; color: var(--sub); font-size: 10px; transition: color .15s; }
  .nav-item .ni { font-size: 22px; display: block; line-height: 1.2; }
  .nav-item.active { color: var(--blue); }

  /* FORM */
  .form-wrap { padding: 16px; }
  .section-label { font-size: 11px; font-weight: 600; color: var(--sub); text-transform: uppercase; letter-spacing: 0.8px; margin: 20px 0 8px; }
  .card { background: var(--white); border-radius: var(--r); overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
  .field { display: flex; align-items: center; padding: 14px 16px; border-bottom: 1px solid var(--border); gap: 10px; }
  .field:last-child { border-bottom: none; }
  .field label { font-size: 14px; color: var(--text); min-width: 68px; flex-shrink: 0; }
  .field input, .field select, .field textarea { flex: 1; border: none; outline: none; font-size: 14px; color: var(--text); background: transparent; font-family: inherit; text-align: right; }
  .field textarea { text-align: left; resize: none; height: 60px; }

  /* MODE GRID */
  .mode-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .mode-btn { border: 2px solid var(--border); border-radius: var(--r); padding: 14px 10px; text-align: center; cursor: pointer; transition: all .15s; background: var(--white); }
  .mode-btn .icon { font-size: 26px; margin-bottom: 6px; }
  .mode-btn .name { font-size: 13px; font-weight: 600; color: var(--text); }
  .mode-btn .detail { font-size: 10px; color: var(--sub); margin-top: 2px; }
  .mode-btn.sel-hsr      { border-color: #E8530A; background: #FFF3EE; }
  .mode-btn.sel-hsr-taxi { border-color: #D97706; background: #FFFBEB; }
  .mode-btn.sel-car      { border-color: #2563EB; background: #EFF6FF; }
  .mode-btn.sel-govt     { border-color: #16A34A; background: #F0FDF4; }

  .btn-submit { width: 100%; padding: 16px; background: var(--blue); color: #fff; font-size: 16px; font-weight: 700; border: none; border-radius: var(--r); margin-top: 24px; margin-bottom: calc(16px + var(--safe-bottom)); cursor: pointer; }
  .btn-submit:active { opacity: .85; }

  /* CALENDAR */
  .cal-wrap { padding: 16px; }
  .cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .cal-nav .arrow { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 8px 16px; cursor: pointer; font-size: 16px; color: var(--navy); }
  .cal-nav .month-title { font-size: 17px; font-weight: 700; color: var(--navy); }
  .cal-grid { background: var(--white); border-radius: var(--r); box-shadow: 0 1px 4px rgba(0,0,0,.06); overflow: hidden; }
  .cal-header { display: grid; grid-template-columns: repeat(7,1fr); background: var(--navy); }
  .cal-dow { text-align: center; padding: 10px 0; font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.7); }
  .cal-dow:first-child { color: #FF8A80; }
  .cal-dow:last-child  { color: #80D8FF; }
  .cal-days { display: grid; grid-template-columns: repeat(7,1fr); }
  .cal-day { min-height: 58px; padding: 6px 4px 4px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); cursor: pointer; position: relative; transition: background .1s; }
  .cal-day:nth-child(7n) { border-right: none; }
  .cal-day.empty { background: #FAFBFC; cursor: default; }
  .cal-day.today .day-num { background: var(--blue); color: #fff; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; }
  .cal-day.sunday .day-num { color: var(--red); }
  .cal-day.saturday .day-num { color: var(--blue); }
  .day-num { font-size: 13px; font-weight: 600; color: var(--text); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; margin: 0 auto 2px; }
  .day-modes { display: flex; flex-wrap: wrap; gap: 2px; justify-content: center; margin-top: 2px; }
  .day-dot { width: 18px; height: 18px; border-radius: 4px; font-size: 10px; display: flex; align-items: center; justify-content: center; }

  /* LEGEND */
  .legend { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .legend-item { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--gray); }
  .legend-dot { width: 18px; height: 18px; border-radius: 4px; font-size: 10px; display: flex; align-items: center; justify-content: center; }

  /* DAY DETAIL MODAL */
  .modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 200; display: none; align-items: flex-end; }
  .modal-bg.open { display: flex; }
  .modal { background: var(--white); border-radius: 20px 20px 0 0; width: 100%; padding: 20px; padding-bottom: calc(20px + var(--safe-bottom)); max-height: 70dvh; overflow-y: auto; }
  .modal-handle { width: 36px; height: 4px; background: var(--border); border-radius: 2px; margin: 0 auto 16px; }
  .modal-date { font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 14px; }
  .modal-rec { display: flex; align-items: center; gap: 10px; padding: 12px; background: var(--light); border-radius: 10px; margin-bottom: 8px; }
  .modal-rec .icon { font-size: 24px; }
  .modal-rec .info .mode { font-size: 13px; font-weight: 600; color: var(--text); }
  .modal-rec .info .dir  { font-size: 12px; color: var(--gray); }
  .modal-rec .info .note { font-size: 11px; color: var(--teal); margin-top: 2px; }
  .modal-del { margin-left: auto; background: none; border: none; font-size: 18px; color: var(--sub); cursor: pointer; padding: 4px; }
  .modal-empty { text-align: center; padding: 30px; color: var(--sub); font-size: 14px; }
  .modal-add { width: 100%; padding: 13px; background: var(--blue); color: #fff; font-size: 14px; font-weight: 600; border: none; border-radius: 10px; margin-top: 10px; cursor: pointer; }

  /* RECORDS */
  .records-wrap { padding: 16px; }
  .filter-row { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; margin-bottom: 14px; }
  .filter-row::-webkit-scrollbar { display: none; }
  .filter-chip { white-space: nowrap; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; border: 1.5px solid var(--border); background: var(--white); color: var(--gray); cursor: pointer; flex-shrink: 0; }
  .filter-chip.active { background: var(--navy); color: #fff; border-color: var(--navy); }
  .rec-card { background: var(--white); border-radius: var(--r); margin-bottom: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.06); cursor: pointer; }
  .rec-header { display: flex; align-items: center; padding: 12px 14px; gap: 10px; }
  .rec-badge { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
  .rec-badge.hsr { background: #FFF3EE; }
  .rec-badge.hsr-taxi { background: #FFFBEB; }
  .rec-badge.car { background: #EFF6FF; }
  .rec-badge.govt { background: #F0FDF4; }
  .rec-info { flex: 1; }
  .rec-date { font-size: 13px; font-weight: 700; color: var(--text); }
  .rec-mode { font-size: 12px; color: var(--gray); margin-top: 1px; }
  .rec-note-text { font-size: 11px; color: var(--teal); margin-top: 2px; }
  .rec-right { text-align: right; }
  .rec-dir { font-size: 11px; padding: 3px 8px; border-radius: 10px; font-weight: 600; background: #F1F5F9; color: var(--gray); }
  .rec-body { border-top: 1px solid var(--border); padding: 10px 14px; display: none; }
  .rec-body.open { display: block; }
  .rec-body-row { display: flex; justify-content: space-between; font-size: 13px; padding: 4px 0; border-bottom: 1px solid #F8FAFC; }
  .rec-body-row:last-child { border-bottom: none; }
  .rec-body-row .k { color: var(--gray); }
  .rec-body-row .v { font-weight: 600; color: var(--text); }
  .rec-del { width: 100%; padding: 9px; border: 1.5px solid #FECACA; border-radius: 8px; background: #FFF5F5; color: var(--red); font-size: 13px; font-weight: 600; cursor: pointer; margin-top: 10px; }
  .empty { text-align: center; padding: 60px 20px; color: var(--sub); }
  .empty .icon { font-size: 48px; margin-bottom: 12px; }
  .empty p { font-size: 14px; }

  /* EXPORT */
  .export-wrap { padding: 16px; }
  .export-card { background: var(--white); border-radius: var(--r); padding: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: 12px; }
  .export-title { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .export-sub { font-size: 12px; color: var(--sub); margin-bottom: 12px; }
  .btn-export { width: 100%; padding: 13px; background: var(--navy); color: #fff; font-size: 14px; font-weight: 600; border: none; border-radius: 10px; cursor: pointer; margin-top: 6px; }
  .btn-export.red { background: transparent; color: var(--red); border: 1.5px solid var(--red); margin-top: 8px; }

  /* TOAST */
  .toast { position: fixed; bottom: calc(80px + var(--safe-bottom)); left: 50%; transform: translateX(-50%) translateY(20px); background: #1E293B; color: #fff; padding: 10px 20px; border-radius: 20px; font-size: 13px; font-weight: 500; opacity: 0; transition: all .3s; white-space: nowrap; z-index: 999; pointer-events: none; }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>
</head>
<body>

<div class="topbar">
  <div>
    <div class="sub">CosX Solution</div>
    <h1>通勤記錄</h1>
  </div>
  <div class="stat-box">
    <div class="stat-num" id="topCount">0</div>
    <div class="stat-label">本月筆數</div>
  </div>
</div>

<div class="page-content">

  <!-- ADD PAGE -->
  <div class="page active" id="page-add">
    <div class="form-wrap">
      <div class="section-label">通勤日期與方向</div>
      <div class="card">
        <div class="field">
          <label>日期</label>
          <input type="date" id="f-date">
        </div>
        <div class="field">
          <label>方向</label>
          <select id="f-direction">
            <option value="上班">上班</option>
            <option value="下班">下班</option>
          </select>
        </div>
      </div>

      <div class="section-label">通勤方式</div>
      <div class="mode-grid">
        <div class="mode-btn" data-mode="hsr" onclick="selectMode('hsr')">
          <div class="icon">🚄</div>
          <div class="name">高鐵</div>
          <div class="detail">需電子票據</div>
        </div>
        <div class="mode-btn" data-mode="hsr-taxi" onclick="selectMode('hsr-taxi')">
          <div class="icon">🚄🚕</div>
          <div class="name">高鐵＋計程車</div>
          <div class="detail">需電子票據</div>
        </div>
        <div class="mode-btn" data-mode="car" onclick="selectMode('car')">
          <div class="icon">🚗</div>
          <div class="name">私家車</div>
          <div class="detail">需加油發票</div>
        </div>
        <div class="mode-btn" data-mode="govt" onclick="selectMode('govt')">
          <div class="icon">🚐</div>
          <div class="name">公務車</div>
          <div class="detail">無需報帳</div>
        </div>
      </div>

      <div class="section-label">備註（選填）</div>
      <div class="card">
        <div class="field">
          <textarea id="f-note" placeholder="例：出差台北、加油金額..."></textarea>
        </div>
      </div>

      <button class="btn-submit" onclick="saveRecord()">✅ 儲存記錄</button>
    </div>
  </div>

  <!-- CALENDAR PAGE -->
  <div class="page" id="page-cal">
    <div class="cal-wrap">
      <div class="cal-nav">
        <button class="arrow" onclick="changeCalMonth(-1)">◀</button>
        <div class="month-title" id="calTitle"></div>
        <button class="arrow" onclick="changeCalMonth(1)">▶</button>
      </div>
      <div class="legend">
        <div class="legend-item"><div class="legend-dot" style="background:#FFF3EE">🚄</div>高鐵</div>
        <div class="legend-item"><div class="legend-dot" style="background:#FFFBEB">🚕</div>高鐵+計程車</div>
        <div class="legend-item"><div class="legend-dot" style="background:#EFF6FF">🚗</div>私家車</div>
        <div class="legend-item"><div class="legend-dot" style="background:#F0FDF4">🚐</div>公務車</div>
      </div>
      <div class="cal-grid">
        <div class="cal-header">
          <div class="cal-dow">日</div><div class="cal-dow">一</div><div class="cal-dow">二</div>
          <div class="cal-dow">三</div><div class="cal-dow">四</div><div class="cal-dow">五</div>
          <div class="cal-dow">六</div>
        </div>
        <div class="cal-days" id="calDays"></div>
      </div>
    </div>
  </div>

  <!-- RECORDS PAGE -->
  <div class="page" id="page-records">
    <div class="records-wrap">
      <div class="filter-row">
        <div class="filter-chip active" onclick="setFilter('all',this)">全部</div>
        <div class="filter-chip" onclick="setFilter('hsr',this)">🚄 高鐵</div>
        <div class="filter-chip" onclick="setFilter('hsr-taxi',this)">🚄🚕 高鐵＋計程車</div>
        <div class="filter-chip" onclick="setFilter('car',this)">🚗 私家車</div>
        <div class="filter-chip" onclick="setFilter('govt',this)">🚐 公務車</div>
      </div>
      <div id="recordList"></div>
    </div>
  </div>

  <!-- EXPORT PAGE -->
  <div class="page" id="page-export">
    <div class="export-wrap">
      <div class="section-label">匯出報表</div>
      <div class="export-card">
        <div class="export-title">📋 匯出全部記錄</div>
        <div class="export-sub">匯出所有記錄為 CSV，可貼入 Excel 或 Numbers</div>
        <button class="btn-export" onclick="exportCSV('all')">匯出全部（CSV）</button>
      </div>
      <div class="export-card">
        <div class="export-title">📅 匯出本月記錄</div>
        <div class="export-sub" id="exportMonthSub"></div>
        <button class="btn-export" onclick="exportCSV('month')">匯出本月（CSV）</button>
      </div>
      <div class="export-card">
        <div class="export-title">⚠️ 清除所有資料</div>
        <div class="export-sub">此操作無法復原，請先匯出備份</div>
        <button class="btn-export red" onclick="clearAll()">清除所有記錄</button>
      </div>
    </div>
  </div>

</div>

<!-- BOTTOM NAV -->
<div class="bottom-nav">
  <div class="nav-item active" id="nav-add" onclick="goPage('add')"><span class="ni">➕</span>新增</div>
  <div class="nav-item" id="nav-cal" onclick="goPage('cal')"><span class="ni">📅</span>行事曆</div>
  <div class="nav-item" id="nav-records" onclick="goPage('records')"><span class="ni">📋</span>記錄</div>
  <div class="nav-item" id="nav-export" onclick="goPage('export')"><span class="ni">📤</span>匯出</div>
</div>

<!-- DAY MODAL -->
<div class="modal-bg" id="modalBg" onclick="closeModal(event)">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-date" id="modalDate"></div>
    <div id="modalContent"></div>
    <button class="modal-add" onclick="addFromModal()">➕ 新增這天的記錄</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const MODE_META = {
  'hsr':      { label:'高鐵',        icon:'🚄',    bg:'#FFF3EE', cls:'hsr',      needReceipt:true  },
  'hsr-taxi': { label:'高鐵＋計程車', icon:'🚄🚕',  bg:'#FFFBEB', cls:'hsr-taxi', needReceipt:true  },
  'car':      { label:'私家車',       icon:'🚗',    bg:'#EFF6FF', cls:'car',      needReceipt:true  },
  'govt':     { label:'公務車',       icon:'🚐',    bg:'#F0FDF4', cls:'govt',     needReceipt:false },
};

let records = [];
let currentMode = null;
let currentFilter = 'all';
let calDate = new Date();
let modalDateStr = null;

function init() {
  const saved = localStorage.getItem('commute-v2');
  if (saved) records = JSON.parse(saved);
  const today = new Date();
  document.getElementById('f-date').value = today.toISOString().slice(0,10);
  calDate = new Date(today.getFullYear(), today.getMonth(), 1);
  updateTopCount();
  renderCal();
  updateExportLabel();
}

function save() {
  localStorage.setItem('commute-v2', JSON.stringify(records));
  updateTopCount();
}

function updateTopCount() {
  const m = new Date();
  const n = records.filter(r => {
    const d = new Date(r.date);
    return d.getFullYear()===m.getFullYear() && d.getMonth()===m.getMonth();
  }).length;
  document.getElementById('topCount').textContent = n;
}

function goPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  document.getElementById('nav-'+name).classList.add('active');
  if (name==='records') renderRecords();
  if (name==='cal') renderCal();
  if (name==='export') updateExportLabel();
}

function selectMode(mode) {
  currentMode = mode;
  document.querySelectorAll('.mode-btn').forEach(b => {
    b.className = 'mode-btn';
    if (b.dataset.mode === mode) b.classList.add('sel-'+mode);
  });
}

function saveRecord() {
  const date = document.getElementById('f-date').value;
  const direction = document.getElementById('f-direction').value;
  const note = document.getElementById('f-note').value.trim();
  if (!date) { showToast('請選擇日期'); return; }
  if (!currentMode) { showToast('請選擇通勤方式'); return; }
  records.unshift({ id: Date.now(), date, direction, mode: currentMode, note });
  save();
  currentMode = null;
  document.querySelectorAll('.mode-btn').forEach(b => b.className='mode-btn');
  document.getElementById('f-note').value = '';
  showToast('✅ 記錄已儲存');
  setTimeout(() => goPage('cal'), 700);
}

// ── CALENDAR ──
function changeCalMonth(d) {
  calDate.setMonth(calDate.getMonth()+d);
  renderCal();
}

function renderCal() {
  const y = calDate.getFullYear(), m = calDate.getMonth();
  document.getElementById('calTitle').textContent = `${y} 年 ${m+1} 月`;
  const first = new Date(y, m, 1).getDay();
  const days  = new Date(y, m+1, 0).getDate();
  const today = new Date();
  const todayStr = today.toISOString().slice(0,10);

  // build date→records map
  const map = {};
  records.forEach(r => {
    const d = new Date(r.date);
    if (d.getFullYear()===y && d.getMonth()===m) {
      if (!map[r.date]) map[r.date] = [];
      map[r.date].push(r);
    }
  });

  let html = '';
  for (let i=0; i<first; i++) html += `<div class="cal-day empty"></div>`;
  for (let d=1; d<=days; d++) {
    const ds = `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const dow = (first + d - 1) % 7;
    const isToday = ds === todayStr;
    const cls = [
      'cal-day',
      isToday ? 'today' : '',
      dow===0 ? 'sunday' : '',
      dow===6 ? 'saturday' : ''
    ].filter(Boolean).join(' ');

    const recs = map[ds] || [];
    const dots = recs.map(r => {
      const meta = MODE_META[r.mode];
      return `<div class="day-dot" style="background:${meta.bg}" title="${meta.label}">${meta.icon}</div>`;
    }).join('');

    html += `<div class="${cls}" onclick="openDayModal('${ds}')">
      <div class="day-num">${d}</div>
      <div class="day-modes">${dots}</div>
    </div>`;
  }
  document.getElementById('calDays').innerHTML = html;
}

// ── DAY MODAL ──
function openDayModal(dateStr) {
  modalDateStr = dateStr;
  const d = new Date(dateStr);
  const weekDay = ['日','一','二','三','四','五','六'][d.getDay()];
  document.getElementById('modalDate').textContent =
    `${dateStr.replace(/-/g,'/')}（${weekDay}）`;

  const recs = records.filter(r => r.date === dateStr);
  let html = '';
  if (recs.length === 0) {
    html = `<div class="modal-empty">這天還沒有記錄</div>`;
  } else {
    html = recs.map(r => {
      const meta = MODE_META[r.mode];
      return `<div class="modal-rec">
        <div class="icon">${meta.icon}</div>
        <div class="info">
          <div class="mode">${meta.label}</div>
          <div class="dir">${r.direction}</div>
          ${r.note ? `<div class="note">${r.note}</div>` : ''}
        </div>
        <button class="modal-del" onclick="deleteFromModal(${r.id})">🗑</button>
      </div>`;
    }).join('');
  }
  document.getElementById('modalContent').innerHTML = html;
  document.getElementById('modalBg').classList.add('open');
}

function closeModal(e) {
  if (e.target === document.getElementById('modalBg'))
    document.getElementById('modalBg').classList.remove('open');
}

function deleteFromModal(id) {
  if (!confirm('確定刪除？')) return;
  records = records.filter(r => r.id !== id);
  save();
  openDayModal(modalDateStr);
  renderCal();
  showToast('已刪除');
}

function addFromModal() {
  document.getElementById('modalBg').classList.remove('open');
  document.getElementById('f-date').value = modalDateStr;
  goPage('add');
}

// ── RECORDS ──
function setFilter(f, el) {
  currentFilter = f;
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  renderRecords();
}

function renderRecords() {
  const list = document.getElementById('recordList');
  let data = [...records].sort((a,b) => new Date(b.date)-new Date(a.date));
  if (currentFilter !== 'all') data = data.filter(r => r.mode === currentFilter);
  if (!data.length) {
    list.innerHTML = `<div class="empty"><div class="icon">🗂️</div><p>沒有符合的記錄</p></div>`;
    return;
  }
  list.innerHTML = data.map(r => {
    const meta = MODE_META[r.mode];
    const ds = r.date.replace(/-/g,'/');
    const dow = ['日','一','二','三','四','五','六'][new Date(r.date).getDay()];
    return `<div class="rec-card" onclick="toggleRec(${r.id})">
      <div class="rec-header">
        <div class="rec-badge ${meta.cls}">${meta.icon}</div>
        <div class="rec-info">
          <div class="rec-date">${ds}（${dow}）</div>
          <div class="rec-mode">${meta.label}</div>
          ${r.note ? `<div class="rec-note-text">📝 ${r.note}</div>` : ''}
        </div>
        <div class="rec-right"><div class="rec-dir">${r.direction}</div></div>
      </div>
      <div class="rec-body" id="body-${r.id}">
        <div class="rec-body-row"><span class="k">通勤方式</span><span class="v">${meta.icon} ${meta.label}</span></div>
        <div class="rec-body-row"><span class="k">方向</span><span class="v">${r.direction}</span></div>
        <div class="rec-body-row"><span class="k">需報帳</span><span class="v">${meta.needReceipt ? '✅ 是' : '❌ 否'}</span></div>
        ${r.note ? `<div class="rec-body-row"><span class="k">備註</span><span class="v">${r.note}</span></div>` : ''}
        <button class="rec-del" onclick="event.stopPropagation();deleteRec(${r.id})">🗑 刪除此記錄</button>
      </div>
    </div>`;
  }).join('');
}

function toggleRec(id) {
  document.getElementById('body-'+id).classList.toggle('open');
}

function deleteRec(id) {
  if (!confirm('確定要刪除？')) return;
  records = records.filter(r => r.id !== id);
  save(); renderRecords(); renderCal();
  showToast('已刪除');
}

// ── EXPORT ──
function updateExportLabel() {
  const m = new Date();
  document.getElementById('exportMonthSub').textContent =
    `${m.getFullYear()} 年 ${m.getMonth()+1} 月的通勤記錄`;
}

function exportCSV(type) {
  let data = [...records].sort((a,b) => new Date(a.date)-new Date(b.date));
  if (type==='month') {
    const m = new Date();
    data = data.filter(r => {
      const d = new Date(r.date);
      return d.getFullYear()===m.getFullYear() && d.getMonth()===m.getMonth();
    });
  }
  if (!data.length) { showToast('沒有記錄可匯出'); return; }
  const rows = data.map(r => {
    const meta = MODE_META[r.mode];
    return [r.date, r.direction, meta.label, meta.needReceipt?'需報帳':'無需報帳', r.note||'']
      .map(v=>`"${v}"`).join(',');
  });
  const csv = '\uFEFF' + ['日期,方向,通勤方式,報帳,備註', ...rows].join('\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const fn = type==='month' ? `通勤_${new Date().getFullYear()}${String(new Date().getMonth()+1).padStart(2,'0')}.csv` : '通勤_全部.csv';
  a.href=url; a.download=fn; a.click();
  URL.revokeObjectURL(url);
  showToast('✅ 已匯出 '+fn);
}

function clearAll() {
  if (!confirm('確定清除所有記錄？此操作無法復原！')) return;
  records = []; save(); renderRecords(); renderCal();
  showToast('已清除');
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}

init();
</script>
</body>
</html>
